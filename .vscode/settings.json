{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.tabSize": 2,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#ffffff",
    "activityBar.activeBorder": "#15202b",
    "activityBar.background": "#ffffff",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#df9f9f",
    "activityBarBadge.foreground": "#15202b",
    "activityBarTop.activeBackground": "#ffffff",
    "activityBarTop.activeBorder": "#15202b",
    "activityBarTop.background": "#ffffff",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.border": "#15202b99",
    "commandCenter.foreground": "#595959",
    "sash.hoverBorder": "#ffffff",
    "statusBar.background": "#ededed",
    "statusBar.debuggingBackground": "#ededed",
    "statusBar.debuggingForeground": "#15202b",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#d3d3d3",
    "statusBarItem.remoteBackground": "#d78787",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#ededed",
    "titleBar.activeForeground": "#595959",
    "titleBar.inactiveBackground": "#ededed99",
    "titleBar.inactiveForeground": "#15202b99"
  },
  "peacock.color": "#ededed"
}
